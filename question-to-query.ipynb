import torch
from transformers import AutoModelForCausalLM, AutoTokenizer, AutoConfig

model_id = "microsoft/phi-2"

# 1. Load the Tokenizer
tokenizer = AutoTokenizer.from_pretrained(model_id, trust_remote_code=True)
tokenizer.pad_token = tokenizer.eos_token
tokenizer.padding_side = "right" 

# 2. Grab the online configuration blueprint
config = AutoConfig.from_pretrained(model_id, trust_remote_code=True)

# 3. FORCE the pad_token_id into the blueprint before building the model!
config.pad_token_id = tokenizer.eos_token_id

# 4. Build the model using our custom blueprint
model = AutoModelForCausalLM.from_pretrained(
    model_id,
    config=config,             # Tells the wrapper to use our fixed config
    device_map="auto",
    trust_remote_code=True,
    torch_dtype=torch.bfloat16, # bfloat16 has the exact same dynamic range as a full 32-bit float but uses half the memory.
)

# 5. Check your memory footprint
print(f"Memory used: {model.get_memory_footprint()/1e9:.2f} GB")

